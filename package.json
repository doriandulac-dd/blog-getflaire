{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run blog-sitemap",
    "build": "vite build",
    "postbuild": "node scripts/validate-sitemap.js",
    "sitemap": "npm run blog-sitemap",
    "sitemap:test": "node scripts/test-sitemap.js",
    "sitemap:validate": "node scripts/validate-sitemap.js",
    "blog-sitemap": "node scripts/generate-blog-sitemap.js",
    "blog-sitemap:watch": "node scripts/auto-update-sitemap.js --start",
    "blog-sitemap:force": "node scripts/auto-update-sitemap.js --force",
    "webhook:start": "node scripts/webhook-sitemap-update.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.57.4",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "7.3.7"
  }
}
